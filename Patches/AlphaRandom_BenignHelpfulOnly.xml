						<!-- Vanilla Social Interactions Expanded -->
						<li MayRequire="vanillaexpanded.vanillasocialinteractionsexpanded">VSIE_OneNightStand</li>	<!-- One night stand -->
						<!-- [AV] Toxic Waste Disposer -->
						<li MayRequire="veltaris.wastecollector">AV_WasteDisposalOpporunity</li>	<!-- Toxic waste disposal opportunity -->
						<!-- Biomes! Polluted Lands -->
						<li MayRequire="biomesteam.biomespollutedlands">BMT_HagbloomSprout</li>	<!-- hagbloom sprout -->
						<!-- Gulden Biome (Continued) -->
						<li MayRequire="pphhyy.guldennew">EldenRim_GuldenAmbrosiaSprout</li>	<!-- Gulden ambrosia sprout -->
						<!-- Biomes! Caverns -->
						<li MayRequire="biomesteam.biomescaverns">BMT_AmbrosyxSprout</li>	<!-- ambrosyx sprout -->
						<li MayRequire="biomesteam.biomescaverns">BMT_Incident_PhosphoricLights</li>	<!-- phosphoric lights -->
						<!-- Hospitality (Continued) -->
						<li MayRequire="orion.hospitality">HappyGuestJoins</li>	<!-- happy guest joins -->
						<!-- MSS Tweaks and Fun -->
						<li MayRequire="mss.flavourpack">MSSFP_WandererJoin_Template</li>	<!-- a familiar face arrives -->
						<!-- Alpha Animals -->
						<li MayRequire="sarg.alphaanimals">AA_ResourcePodCrash</li>	<!-- alpha animal resource pod crash -->
						</whiteList>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
