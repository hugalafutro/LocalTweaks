						<li MayRequire="albion.sparklingworlds.full">TradeFairSW</li>	<!-- trade fair -->
						<li MayRequire="albion.sparklingworlds.full">HuntingLodgeOppSW</li>	<!-- hunting lodge opportunity -->
						<li MayRequire="albion.sparklingworlds.full">WeaponsCachePodCrashSW</li>	<!-- weapons cache pod crash -->
						<!-- Vanilla Events Expanded -->
						<li MayRequire="vanillaexpanded.vee">VEE_CropSprout</li>	<!-- crop sprout -->
						<li MayRequire="vanillaexpanded.vee">VEE_AnimalPodCrash</li>	<!-- animal pod crash -->
						<li MayRequire="vanillaexpanded.vee">VEE_Cargopodsweapons</li>	<!-- cargo pods (weapon) -->
						<li MayRequire="vanillaexpanded.vee">VEE_Cargopodsapparel</li>	<!-- cargo pods (apparel) -->
						<li MayRequire="vanillaexpanded.vee">VEE_CaravanAnimalsWanderIn</li>	<!-- caravan animals wander in -->
