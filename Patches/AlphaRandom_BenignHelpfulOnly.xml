<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Alpha Random's benign archotech fate manipulator rolls one incident uniformly from its whiteList plus
	     every IncidentDef in the Misc and GiveQuest categories, minus a vanilla/DLC/VEE blacklist. Mods file
	     threats and weather under Misc (Leo - Events: ~70, Alpha Animals: clutch mothers, behemoths...), so
	     most rolls were bad or useless. Its incident picker (CompTargetEffect_TriggerIncident.ChooseRandomIncident)
	     uses only whiteList when incidentTypes is empty, so the categories go and whiteList becomes a hand-picked
	     list of helpful incidents from the active mods (reviewed 2026-11-21). Opt-in quests count as helpful.
	     New mods add nothing to this pool; add their good incidents here. -->
	<Operation Class="PatchOperationFindMod">
		<mods><li>Alpha Random</li></mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="ARandom_FateManipulator_Benign"]/comps/li[@Class="AlphaRandom.CompProperties_TargetEffect_TriggerIncident"]/incidentTypes</xpath>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="ARandom_FateManipulator_Benign"]/comps/li[@Class="AlphaRandom.CompProperties_TargetEffect_TriggerIncident"]/blacklist</xpath>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="ARandom_FateManipulator_Benign"]/comps/li[@Class="AlphaRandom.CompProperties_TargetEffect_TriggerIncident"]/whiteList</xpath>
					<value>
						<whiteList>
						<!-- Core -->
						<li>ShipChunkDrop</li>	<!-- ship chunk drop -->
						<li>OrbitalTraderArrival</li>	<!-- orbital trader arrival -->
						<li>TraderCaravanArrival</li>	<!-- trader caravan arrival -->
						<li>VisitorGroup</li>	<!-- visitor group -->
						<li>TravelerGroup</li>	<!-- traveler group -->
						<li>RaidFriendly</li>	<!-- friendly raid -->
						<li>ResourcePodCrash</li>	<!-- resource pod crash -->
						<li>PsychicSoothe</li>	<!-- psychic soothe -->
						<li>SelfTame</li>	<!-- self-tame -->
						<li>AmbrosiaSprout</li>	<!-- ambrosia sprout -->
						<li>FarmAnimalsWanderIn</li>	<!-- farm animals wander in -->
						<li>WandererJoin</li>	<!-- wanderer join -->
						<li>RefugeePodCrash</li>	<!-- transport pod crash -->
						<li>MeteoriteImpact</li>	<!-- meteorite impact -->
						<li>WildManWandersIn</li>	<!-- wild man wanders in -->
						<li>Aurora</li>	<!-- aurora -->
						<li>GiveQuest_Random</li>	<!-- quest -->
						<!-- ludeon.rimworld.royalty -->
						<li MayRequire="ludeon.rimworld.royalty">AnimaTreeSpawn</li>	<!-- anima tree -->
						<!-- ludeon.rimworld.ideology -->
						<li MayRequire="ludeon.rimworld.ideology">GauranlenPodSpawn</li>	<!-- Gauranlen pod sprout -->
						<li MayRequire="ludeon.rimworld.ideology">GiveQuest_WorkSite</li>	<!-- work site -->
						<!-- ludeon.rimworld.biotech -->
						<li MayRequire="ludeon.rimworld.biotech">PoluxTreeSpawn</li>	<!-- polux tree -->
						<li MayRequire="ludeon.rimworld.biotech">RefugeePodCrash_Baby</li>	<!-- transport pod crash -->
						<!-- ludeon.rimworld.odyssey -->
						<li MayRequire="ludeon.rimworld.odyssey">BioluminescentSpores</li>	<!-- bioluminescent spores -->
						<li MayRequire="ludeon.rimworld.odyssey">BoomshroomSprout</li>	<!-- boomshroom sprout -->
						<!-- Erin Eccentric -->
						<li MayRequire="erin.storyteller">EE_SelfTameCustom</li>	<!-- self-tame -->
						<!-- Go Explore! -->
						<li MayRequire="albion.goexplore">LostCityLGE</li>	<!-- lost city -->
						<li MayRequire="albion.goexplore">AmbrosiaAnimalsLGE</li>	<!-- ambrosia-addicted animals -->
						<li MayRequire="albion.goexplore">PrisonCampLGE</li>	<!-- prison camp -->
						<li MayRequire="albion.goexplore">QuestResearchRequestSW</li>	<!-- research request opportunity -->
						<li MayRequire="albion.goexplore">InterceptedMessageLGE</li>	<!-- intercepted message -->
						<!-- Leo - Events -->
						<li MayRequire="leo.eventsexpanded">LE_GauranlenBloom</li>	<!-- gauranlen bloom -->
						<li MayRequire="leo.eventsexpanded">LE_VegetativeSpurt</li>	<!-- vegetative spurt -->
						<li MayRequire="leo.eventsexpanded">LE_PsychicCalm</li>	<!-- psychic calm -->
						<li MayRequire="leo.eventsexpanded">LE_AnimaBloom</li>	<!-- anima bloom -->
						<li MayRequire="leo.eventsexpanded">LE_BlackMarket</li>	<!-- black market -->
						<li MayRequire="leo.eventsexpanded">LE_Gift</li>	<!-- gift -->
						<li MayRequire="leo.eventsexpanded">LE_MassInspiration</li>	<!-- mass inspiration -->
						<li MayRequire="leo.eventsexpanded">LE_NutrientRain</li>	<!-- nutrient rain -->
						<li MayRequire="leo.eventsexpanded">LE_PsychicLink</li>	<!-- psychic link -->
						<li MayRequire="leo.eventsexpanded">LE_ResearchBreakthrough</li>	<!-- research breakthrough -->
						<li MayRequire="leo.eventsexpanded">LE_SilverShower</li>	<!-- silver shower -->
						<li MayRequire="leo.eventsexpanded">LE_SuddenEpiphany</li>	<!-- sudden epiphany -->
						<li MayRequire="leo.eventsexpanded">LE_AtmosphericExcitant</li>	<!-- atmospheric excitant -->
