<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Tweaks Galore's "Growable Mushrooms" makes Glowstool and Agarilux sowable with the Ground tag, so they only
	     show in ordinary growing zones. Vanilla Plants Expanded - Mushrooms' mushroom growing zone lists nothing but
	     plants tagged VPE_Mushroom (postfix on PlantUtility.CanSowOnGrower). Add that tag, the way VPE Mushrooms does
	     for the Alpha Biomes mushrooms. Each add only runs when the plant already has sowTags, so nothing happens
	     while the Tweaks Galore setting is off. Must load after neronix17.tweaksgalore. -->
	<Operation Class="PatchOperationConditional" MayRequire="vanillaexpanded.vplantsemushrooms">
		<xpath>/Defs/ThingDef[defName="Glowstool"]/plant/sowTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/ThingDef[defName="Glowstool"]/plant/sowTags</xpath>
			<value>
				<li>VPE_Mushroom</li>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional" MayRequire="vanillaexpanded.vplantsemushrooms">
		<xpath>/Defs/ThingDef[defName="Agarilux"]/plant/sowTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/ThingDef[defName="Agarilux"]/plant/sowTags</xpath>
			<value>
				<li>VPE_Mushroom</li>
			</value>
		</match>
	</Operation>
</Patch>
