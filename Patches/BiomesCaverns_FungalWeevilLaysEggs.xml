<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Biomes! Caverns: BMT_FungalWeevil has an egg layer but inherits vanilla BaseInsect's Insect think tree, which has
	     JobGiver_Mate and no JobGiver_LayEgg. Females sit at "egg progress 100%, fertilized" forever. Give it the Animal
	     trees, as the other Biomes egg-laying insects have (AnimalThingBase). Skips itself if the mod sets its own tree. -->
	<Operation Class="PatchOperationConditional" MayRequire="BiomesTeam.BiomesCaverns">
		<xpath>Defs/ThingDef[defName="BMT_FungalWeevil"]/race/thinkTreeMain</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BMT_FungalWeevil"]/race</xpath>
			<value>
				<thinkTreeMain>Animal</thinkTreeMain>
				<thinkTreeConstant>AnimalConstant</thinkTreeConstant>
			</value>
		</nomatch>
	</Operation>
</Patch>
