<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Vanilla Furniture Expanded's 2x1 weapon rack (Shelf_WeaponRack, 12 weapons) cannot be placed over Reel's
	Expanded Storage's 2x1 wooden weapon rack (ReelStorageWeaponRack, 8 weapons): they share no replace tag. Give both
	the tag "WeaponRack2x1", so one replaces the other in place (Replace Stuff), weapons, storage settings and storage
	group kept (Harmony3StrictCompat handles the [sbz] overlap check and the contents). -->
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Shelf_WeaponRack" or defName="ReelStorageWeaponRack"][not(replaceTags)]</xpath>
		<value>
			<replaceTags />
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Shelf_WeaponRack" or defName="ReelStorageWeaponRack"]/replaceTags</xpath>
		<value>
			<li>WeaponRack2x1</li>
		</value>
	</Operation>
</Patch>
