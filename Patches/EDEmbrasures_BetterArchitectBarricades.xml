<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Better Architect Menu moves the [HRK] embrasures to its Barricades category but does not know ED-Embrasures
	     (Continued), whose embrasure inherits the wall category from its parent and so stays under Walls. Give it its
	     own category node, which wins over the inherited one. -->
	<Operation Class="PatchOperationAdd" MayRequire="ganja.ed.embrasures,ferny.betterarchitect">
		<xpath>Defs/ThingDef[defName="ED_Embrasure"]</xpath>
		<value>
			<designationCategory>Ferny_Barricades</designationCategory>
		</value>
	</Operation>
</Patch>
