<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <AbilityDef>
    <defName>MPX_SummonGloomTree</defName>
    <label>summon harbinger tree</label>
    <description>Resonate with a distant dark archotech intelligence and summon a harbinger tree to the colony.</description>
    <iconPath>UI/Icons/Abilities/MPX_SummonGloomTree</iconPath>
    <cooldownTicksRange>900000</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <targetRequired>false</targetRequired>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>15</warmupTime>
      <drawAimPie>false</drawAimPie>
      <targetable>false</targetable>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MorePhytokinXenotypes.CompProperties_MPX_SummonGloomTree" />
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>MPX_SiphonGloomTreeNutrition</defName>
    <label>siphon harbinger tree nutrition</label>
    <description>Draw nutrition from a harbinger tree's nutrition bar to fill the carrier's stomach. Each use takes very little nutrition from the tree, yet completely satisfies the gene carrier's hunger.</description>
    <iconPath>UI/Icons/Abilities/MPX_SiphonGloomTreeNutrition</iconPath>
    <cooldownTicksRange>300</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range>
      <warmupTime>2</warmupTime>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetPlants>true</canTargetPlants>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MorePhytokinXenotypes.CompProperties_MPX_SiphonNutrition">
        <treeNutritionCost>0.1</treeNutritionCost>
        <treeDefNames>
          <li>Plant_TreeHarbinger</li>
        </treeDefNames>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>MPX_BreakCorpse</defName>
    <label>pulverize corpse</label>
    <description>Pulverize a corpse into a quantity of meat mush.</description>
    <iconPath>UI/Icons/Abilities/MPX_BreakCorpse</iconPath>
    <cooldownTicksRange>300</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1.9</range>
      <warmupTime>1</warmupTime>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetCorpses>true</canTargetCorpses>
        <onlyTargetCorpses>true</onlyTargetCorpses>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MorePhytokinXenotypes.CompProperties_MPX_BreakCorpse" />
    </comps>
  </AbilityDef>
</Defs>
